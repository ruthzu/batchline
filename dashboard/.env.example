# AWS region used by the dashboard's DynamoDB client (non-local deployments).
# In DYNAMODB_LOCAL mode the server-side client defaults to region "local".
AWS_REGION=us-east-1

# Single-table DynamoDB table name (see database.md; server default: batchline)
DYNAMODB_TABLE_NAME=batchline

# "true" -> point at DynamoDB Local (http://localhost:8000) with dummy
# credentials; unset/"false" -> real AWS via the default credential chain
DYNAMODB_LOCAL=true

# Optional: override the local endpoint (defaults to http://localhost:8000)
# DYNAMODB_ENDPOINT=http://localhost:8000
