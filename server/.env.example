# Server port (default 3001)
PORT=3001

# DynamoDB Local
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_TABLE_NAME=batchline

# Dashboard origin allowed by CORS on REST endpoints
DASHBOARD_ORIGIN=http://localhost:3000

# Groq API key for voice command routing (https://console.groq.com/keys)
GROQ_API_KEY=
# Optional: override the routing model (default openai/gpt-oss-120b — the
# originally planned llama-3.3-70b-versatile has been retired from Groq)
GROQ_MODEL=
