{
  "name": "@batchline/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/src/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "provision:db": "tsx scripts/provision-db.ts",
    "test:demo": "tsx src/integration-tests/demo-script.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@modelcontextprotocol/sdk": "^1.15.0",
    "groq-sdk": "^1.6.0",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0"
  }
}
